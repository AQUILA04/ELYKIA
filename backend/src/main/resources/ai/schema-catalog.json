        { "name": "total_marge_value", "type": "double", "synonyms": ["marge stock"] },
        { "name": "last_unit_price", "type": "double" },
        { "name": "last_purchase_price", "type": "double" }
      ],
      "relations": [
        { "column": "monthly_stock_id", "refTable": "commercial_monthly_stock", "refColumn": "id" },
        { "column": "article_id", "refTable": "articles", "refColumn": "id" }
      ]
    },
    {
      "name": "commercial_stock_movement",
      "description": "Mouvement de stock commercial (vente crédit, cash, entrée, retour, ajustement)",
      "synonyms": ["mouvement stock", "sortie stock vente"],
      "rowLevelFilter": "collector",
      "columns": [
        { "name": "id", "type": "bigint" },
        { "name": "stock_item_id", "type": "bigint", "description": "FK commercial_monthly_stock_item" },
        { "name": "article_id", "type": "bigint" },
        { "name": "collector", "type": "varchar", "synonyms": ["commercial"] },
        { "name": "movement_type", "type": "varchar", "description": "CREDIT_SALE, CASH_SALE, STOCK_IN, RETURN, ADJUSTMENT" },
        { "name": "quantity_before", "type": "integer" },
        { "name": "quantity_moved", "type": "integer" },
        { "name": "quantity_after", "type": "integer" },
        { "name": "operation_date", "type": "timestamp" },
        { "name": "credit_id", "type": "bigint" },
        { "name": "credit_reference", "type": "varchar" },
        { "name": "stock_return_id", "type": "bigint" },
        { "name": "unit_purchase_price", "type": "double" },
        { "name": "unit_sale_price", "type": "double" },
        { "name": "margin_amount", "type": "double" },
        { "name": "source_type", "type": "varchar" },
        { "name": "source_id", "type": "bigint" }
      ],
      "relations": [
        { "column": "stock_item_id", "refTable": "commercial_monthly_stock_item", "refColumn": "id" },
        { "column": "article_id", "refTable": "articles", "refColumn": "id" },
        { "column": "credit_id", "refTable": "credit", "refColumn": "id" }
      ]
    },
    {
      "name": "article_history",
      "description": "Historique des mouvements stock magasin central (entrées, sorties, retours, reset)",
      "synonyms": ["historique stock magasin", "mouvement stock central"],
      "columns": [
        { "name": "id", "type": "bigint" },
        { "name": "articles_id", "type": "bigint", "description": "FK articles" },
        { "name": "operation_type", "type": "varchar", "description": "ENTREE, SORTIE, RETURN, RESET, INVENTORY_ADJUSTMENT" },
        { "name": "initial_quantity", "type": "integer" },
        { "name": "operation_quantity", "type": "integer" },
        { "name": "final_quantity", "type": "integer" },
        { "name": "operation_date", "type": "date" },
        { "name": "operation_user", "type": "varchar" }
      ],
      "relations": [
        { "column": "articles_id", "refTable": "articles", "refColumn": "id" }
      ]
    },
    {
      "name": "sales_analytics_daily",
      "description": "Agrégation BI ventes journalières",
      "columns": [
        { "name": "date", "type": "date" },
        { "name": "collector", "type": "varchar" },
        { "name": "total_amount", "type": "double" },
        { "name": "sales_count", "type": "integer" }
      ]
    },
    {
      "name": "collection_analytics_daily",
      "description": "Agrégation BI recouvrement journalier",
      "columns": [
        { "name": "date", "type": "date" },
        { "name": "collector", "type": "varchar" },
        { "name": "total_collected", "type": "double" }
      ]
    }
  ],
  "views": [
    { "name": "credit_distribution_view", "description": "Vue agrégée distributions promoteur" }
  ],
  "businessRules": [
    "Le chiffre du jour (ventes crédit) = SUM(credit.total_amount) WHERE date_reg = CURRENT_DATE AND type = 'CREDIT'",
    "Le recouvrement d'un crédit = lignes dans credit_timeline (amount, date_reg, collector) — PAS la table recovery",
    "SUM(credit_timeline.amount) = montant recouvré sur une période",
    "Stock commercial mensuel : commercial_monthly_stock (collector, month, year) + lignes commercial_monthly_stock_item",
    "quantity_remaining = quantity_taken - quantity_sold - quantity_returned sur commercial_monthly_stock_item",
    "Demande sortie magasin = stock_request + stock_request_item ; livraison effective quand status = DELIVERED",
    "Retour terrain = stock_return + stock_return_item vers commercial_monthly_stock",
    "Mouvements terrain détaillés = commercial_stock_movement lié à stock_item_id et optionnellement credit_id",
    "Stock magasin central = articles.stock_quantity ; historique = article_history (ENTREE/SORTIE/RETURN)",
    "Versements caisse = cash_deposit lié à daily_commercial_report via daily_report_id",
    "Pour filtrer stock commercial d'un user PROMOTER : utiliser collector ou commercial_username selon la table",
    "Toujours filtrer visibility = 'ENABLED' si la colonne existe"
  ]
}
