        { "name": "quantity_sold", "type": "integer", "description": "Quantité vendue/distribuée" },
        { "name": "quantity_returned", "type": "integer", "description": "Quantité retournée magasin" },
        { "name": "quantity_remaining", "type": "integer", "synonyms": ["stock restant", "reliquat stock"] },
