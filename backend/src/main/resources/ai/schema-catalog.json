      "rowLevelFilter": "collector",
      "columns": [
        { "name": "id", "type": "bigint" },
        { "name": "collector", "type": "varchar", "synonyms": ["commercial"] },
        { "name": "month", "type": "integer" },
        { "name": "year", "type": "integer" },
        { "name": "status", "type": "varchar", "description": "ACTIVE, etc." }
      ]
    },
    {
      "name": "commercial_monthly_stock_item",
      "description": "Détail stock mensuel par article chez le commercial",
      "synonyms": ["ligne stock commercial", "stock article commercial"],
      "columns": [
        { "name": "id", "type": "bigint" },
        { "name": "monthly_stock_id", "type": "bigint", "description": "FK commercial_monthly_stock" },
        { "name": "article_id", "type": "bigint" },
