{
  "tables": [
    {
      "name": "credit",
      "description": "Vente à crédit — une ligne par opération crédit",
      "synonyms": ["vente", "crédit", "dossier"],
      "rowLevelFilter": "collector",
      "columns": [
        { "name": "id", "type": "bigint", "description": "Identifiant" },
        { "name": "total_amount", "type": "double", "description": "Montant total du crédit", "synonyms": ["chiffre", "CA", "montant"] },
        { "name": "total_amount_paid", "type": "double", "description": "Montant déjà payé" },
        { "name": "total_amount_remaining", "type": "double", "description": "Solde restant" },
        { "name": "collector", "type": "varchar", "description": "Commercial collecteur (username)" },
        { "name": "date_reg", "type": "date", "description": "Date d'enregistrement" },
        { "name": "status", "type": "varchar", "description": "INPROGRESS, SETTLED, etc." },
        { "name": "type", "type": "varchar", "description": "CREDIT, CASH, etc." },
        { "name": "client_type", "type": "varchar", "description": "CLIENT ou PROMOTER" },
        { "name": "client_id", "type": "bigint", "description": "FK client" }
      ],
      "relations": [
        { "column": "client_id", "refTable": "client", "refColumn": "id" }
      ]
    },
    {
      "name": "credit_timeline",
      "description": "Table de recouvrement — chaque ligne = un paiement/mise sur un crédit",
      "synonyms": ["recouvrement", "mise", "paiement", "versement", "timeline"],
      "rowLevelFilter": "collector",
      "columns": [
        { "name": "id", "type": "bigint", "description": "Identifiant" },
        { "name": "credit_id", "type": "bigint", "description": "FK vers credit.id" },
        { "name": "amount", "type": "double", "description": "Montant de la mise", "synonyms": ["mise", "recouvrement"] },
        { "name": "collector", "type": "varchar", "description": "Commercial ayant encaissé" },
        { "name": "date_reg", "type": "date", "description": "Date du paiement" },
        { "name": "total_amount_remaining", "type": "double", "description": "Solde restant après ce paiement" }
      ],
      "relations": [
        { "column": "credit_id", "refTable": "credit", "refColumn": "id" }
      ]
    },
    {
      "name": "credit_articles",
      "description": "Lignes d'articles d'un crédit",
      "synonyms": ["articles vendus"],
      "columns": [
        { "name": "credit_id", "type": "bigint" },
        { "name": "articles_id", "type": "bigint" },
        { "name": "quantity", "type": "integer" },
        { "name": "unit_price", "type": "double" }
      ]
    },
    {
      "name": "client",
      "description": "Clients",
      "synonyms": ["client"],
      "columns": [
        { "name": "id", "type": "bigint" },
        { "name": "firstname", "type": "varchar" },
        { "name": "lastname", "type": "varchar" },
        { "name": "phone", "type": "varchar" },
        { "name": "collector", "type": "varchar" }
      ]
    },
    {
      "name": "articles",
      "description": "Catalogue articles",
      "synonyms": ["produit", "article"],
      "columns": [
        { "name": "id", "type": "bigint" },
        { "name": "name", "type": "varchar" },
        { "name": "purchase_price", "type": "double" },
        { "name": "credit_sale_price", "type": "double" },
        { "name": "stock_quantity", "type": "integer" }
      ]
    },
    {
