        { "name": "total_amount_to_deposit", "type": "double", "synonyms": ["recettes", "à verser"] },
        { "name": "total_amount_deposited", "type": "double", "synonyms": ["versé", "versement caisse"] },
        { "name": "total_credit_amount_deposited", "type": "double" },
        { "name": "total_tontine_amount_deposited", "type": "double" },
