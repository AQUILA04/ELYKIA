# Copier vers deploy/.env.dev pour personnaliser les ports Docker (optionnel).
# Le fichier .env.dev est lu automatiquement par docker compose -f docker-compose.dev.yml

MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# À configurer aussi dans la Run Configuration du backend (IntelliJ / VS Code) :
# MINIO_ENDPOINT=http://localhost:19000
# MINIO_PUBLIC_URL=http://localhost:19000
