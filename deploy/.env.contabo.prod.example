# =============================================================================
# Contabo PROD env example — copy to /opt/elykia/prod/.env on Contabo
# (migration script adapts secrets from DigitalOcean automatically)
# =============================================================================
POSTGRES_USER=elykia_prod
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=elykia_prod_db

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
LOG_PATH=/opt/elykia/prod/logs
PHOTO_FALLBACK_PATH_HOST=/opt/elykia/prod/photos/pending
# Optional override (must match backend Dockerfile APP_UID/APP_GID)
# BACKEND_APP_UID=999
# BACKEND_APP_GID=999

APP_HOSTNAME=elykia.amenouveve-yaveh.com
API_URL=https://elykia.amenouveve-yaveh.com/api
SECURITY_ALLOWED_ORIGINS=https://elykia.amenouveve-yaveh.com,https://clients.amenouveve-yaveh.com,https://www.amenouveve-yaveh.com,https://amenouveve-yaveh.com,http://localhost,capacitor://localhost,http://localhost:8100,https://localhost,ionic://localhost
GA_MEASUREMENT_ID=

# Shared MinIO (optimize-common-infra) — values from Contabo /opt/optimizesolux/common-infra/.env
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=elykia-clients
MINIO_REPORTS_BUCKET=elykia-reports
MINIO_MOBILE_RELEASES_BUCKET=elykia-mobile-releases
MINIO_CUSTOMER_SPACE_RELEASES_BUCKET=elykia-customer-space-releases
MINIO_RECRUITMENT_BUCKET=elykia-recruitment
MINIO_PUBLIC_URL=https://s3.optimizesolux.com
MOBILE_RELEASE_CHANNEL=prod
CUSTOMER_SPACE_RELEASE_CHANNEL=prod

OTEL_SERVICE_NAME=elykia-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=service.namespace=optimizesolux,deployment.environment=prod

# Elykia IA - Vertex AI Gemini (ADC via service account file; do NOT commit the JSON)
ELYKIA_AI_ENABLED=true
ELYKIA_AI_PROVIDER=gemini
ELYKIA_AI_MODEL=gemini-3.8-flash
GOOGLE_CLOUD_PROJECT=elykia-503006
GOOGLE_CLOUD_LOCATION=global
SPRING_AI_VERTEX_AI_GEMINI_API_ENDPOINT=aiplatform.googleapis.com
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp/vertex-ai-sa.json
GCP_VERTEX_SA_PATH=/opt/elykia/secrets/vertex-ai-sa.json
SPRING_AI_MODEL_CHAT=vertexai
# Hotfix Alpine/musl: disable netty native SSL (SIGSEGV on Vertex AI gRPC). Prefer glibc JRE image long-term.
JAVA_TOOL_OPTIONS="-Dio.grpc.netty.shaded.io.netty.handler.ssl.noOpenSsl=true -Dio.grpc.netty.shaded.io.netty.transport.noNative=true"

# OTP SMS espace client — Notification Hub (désactivé par défaut en prod)
# Activer : NOTIFICATION_HUB_ENABLED=true + secret du client Keycloak « elykia » (ne jamais committer)
# NOTIFICATION_HUB_ENVIRONMENT vide = dérivé du profil Spring prod → SMS réel
NOTIFICATION_HUB_ENABLED=false
NOTIFICATION_HUB_BASE_URL=http://notification-hub-prod-api-1:8088
NOTIFICATION_HUB_TENANT_ID=elykia
NOTIFICATION_HUB_APP_ID=elykia-customer-space
NOTIFICATION_HUB_ENVIRONMENT=
NOTIFICATION_HUB_OAUTH2_ENABLED=true
NOTIFICATION_HUB_TOKEN_URI=https://auth.optimizesolux.com/realms/notification-hub/protocol/openid-connect/token
NOTIFICATION_HUB_CLIENT_ID=elykia
NOTIFICATION_HUB_CLIENT_SECRET=
NOTIFICATION_HUB_PROOF_SECRET=

# Customer-space web (deploy-customer-space.sh)
CUSTOMER_SPACE_HOSTNAME=clients.amenouveve-yaveh.com
CUSTOMER_SPACE_API_URL=https://elykia.amenouveve-yaveh.com/api

# Populated by migrate / deploy.sh / deploy-customer-space.sh
FRONTEND_IMAGE=
BACKEND_IMAGE=
CUSTOMER_SPACE_IMAGE=
