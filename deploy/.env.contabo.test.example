# =============================================================================
# Contabo TEST env example — copy to /opt/elykia/test/.env on Contabo
# =============================================================================
POSTGRES_USER=elykia_test
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=elykia_test_db

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
LOG_PATH=/opt/elykia/test/logs
PHOTO_FALLBACK_PATH_HOST=/opt/elykia/test/photos/pending

APP_HOSTNAME=elykia-test.amenouveve-yaveh.com
API_URL=https://elykia-test.amenouveve-yaveh.com/api
SECURITY_ALLOWED_ORIGINS=https://elykia-test.amenouveve-yaveh.com,https://www.amenouveve-yaveh.com,https://amenouveve-yaveh.com,http://localhost,capacitor://localhost,http://localhost:8100,https://localhost,ionic://localhost
GA_MEASUREMENT_ID=

# Shared MinIO (optimize-common-infra) — values from Contabo /opt/optimizesolux/common-infra/.env
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=elykia-clients-test
MINIO_REPORTS_BUCKET=elykia-reports-test
MINIO_MOBILE_RELEASES_BUCKET=elykia-mobile-releases-test
MINIO_CUSTOMER_SPACE_RELEASES_BUCKET=elykia-customer-space-releases-test
MINIO_RECRUITMENT_BUCKET=elykia-recruitment-test
MINIO_PUBLIC_URL=https://s3.optimizesolux.com
MOBILE_RELEASE_CHANNEL=test
CUSTOMER_SPACE_RELEASE_CHANNEL=test

OTEL_SERVICE_NAME=elykia-api-test
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=service.namespace=optimizesolux,deployment.environment=test

# Elykia IA - Vertex AI Gemini (ADC via service account file; do NOT commit the JSON)
ELYKIA_AI_ENABLED=true
ELYKIA_AI_PROVIDER=gemini
ELYKIA_AI_MODEL=gemini-3.8-flash
GOOGLE_CLOUD_PROJECT=elykia-503006
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp/vertex-ai-sa.json
GCP_VERTEX_SA_PATH=/opt/elykia/secrets/vertex-ai-sa.json
SPRING_AI_MODEL_CHAT=vertexai

# Populated by migrate / deploy.sh
FRONTEND_IMAGE=
BACKEND_IMAGE=
